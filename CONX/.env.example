PB_URL=https://uat-qrverify.opsioc.com/api/
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=

# Optional: current CONX login. Defaults to PB_ADMIN_EMAIL for standalone use.
CONX_MODIFIED_USER=

# UAT currently uses a self-signed certificate. Do not enable this for production.
PB_INSECURE_TLS=true
